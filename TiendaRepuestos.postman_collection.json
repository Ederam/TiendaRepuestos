    "name": "Tienda Repuestos - Auth & POS API",
    "description": "Colección de pruebas para autenticación JWT, RFC 7807 y endpoints protegidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://localhost:7298",
