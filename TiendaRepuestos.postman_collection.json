  "item": [
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "1.1 Registro Usuario (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Camilo Ramirez\",\n  \"email\": \"camilo@repuestos.com\",\n  \"password\": \"Password123*\",\n  \"rol\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/registro",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "registro"]
            }
          }
        },
        {
          "name": "1.2 Registro Usuario (Vendedor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Juan Vendedor\",\n  \"email\": \"vendedor@repuestos.com\",\n  \"password\": \"Venta2026*\",\n  \"rol\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/registro",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "registro"]
            }
          }
        },
        {
          "name": "1.3 Login Exitoso (Captura Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('bearer_token', data.token);",
                  "    console.log('Token guardado en variable bearer_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"camilo@repuestos.com\",\n  \"password\": \"Password123*\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "login"]
            }
          }
        },
