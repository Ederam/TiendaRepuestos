    {
      "name": "02. Ventas (Endpoints Protegidos)",
      "item": [
        {
          "name": "2.1 Crear Venta Sin Token (Debe dar 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroComprobante\": \"VTA-0001\",\n  \"metodoPago\": 1,\n  \"detalles\": [\n    {\n      \"productoId\": \"8c2bf51d-5d80-425f-84d0-b7e3f1699999\",\n      \"cantidad\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Ventas",
              "host": ["{{base_url}}"],
              "path": ["api", "Ventas"]
            }
          }
        },
        {
          "name": "2.2 Crear Venta Con Token Válido",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroComprobante\": \"VTA-0001\",\n  \"metodoPago\": 1,\n  \"detalles\": [\n    {\n      \"productoId\": \"8c2bf51d-5d80-425f-84d0-b7e3f1699999\",\n      \"cantidad\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Ventas",
              "host": ["{{base_url}}"],
              "path": ["api", "Ventas"]
            }
          }
        },
        {
          "name": "2.3 Crear Venta Con Token Inválido / Alterado",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tokenFalsoInvalido.firmaFalsa",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroComprobante\": \"VTA-0001\",\n  \"metodoPago\": 1,\n  \"detalles\": [\n    {\n      \"productoId\": \"8c2bf51d-5d80-425f-84d0-b7e3f1699999\",\n      \"cantidad\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Ventas",
              "host": ["{{base_url}}"],
              "path": ["api", "Ventas"]
