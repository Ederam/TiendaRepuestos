{
  "info": {
    "_postman_id": "9b1c7a4e-33f2-4a81-9b1e-62e987c0a1b2",
    "name": "Tienda Repuestos API - Clean Architecture",
    "description": "Colección completa con autenticación JWT, RBAC (Vendedor / Administrador) y pruebas RFC 7807.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://localhost:7298",
      "type": "string"
    },
    {
      "key": "token_admin",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_vendedor",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Autenticación (Auth)",
      "item": [
        {
          "name": "1.1 Registro Usuario Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Camilo Ramirez\",\n  \"email\": \"camilo@repuestos.com\",\n  \"password\": \"Password123*\",\n  \"rol\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/registro",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "registro"]
            }
          }
        },
        {
          "name": "1.2 Registro Usuario Vendedor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Juan Vendedor\",\n  \"email\": \"vendedor@repuestos.com\",\n  \"password\": \"Venta2026*\",\n  \"rol\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/registro",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "registro"]
            }
          }
        },
        {
          "name": "1.3 Login Admin (Guarda token_admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token_admin', json.token);",
                  "    console.log('token_admin actualizado exitosamente');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"camilo@repuestos.com\",\n  \"password\": \"Password123*\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "login"]
            }
          }
        },
        {
          "name": "1.4 Login Vendedor (Guarda token_vendedor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token_vendedor', json.token);",
                  "    console.log('token_vendedor actualizado exitosamente');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vendedor@repuestos.com\",\n  \"password\": \"Venta2026*\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Productos (RBAC)",
      "item": [
        {
          "name": "2.1 Listar Productos (Permitido a Vendedor)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_vendedor}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/Productos",
              "host": ["{{base_url}}"],
              "path": ["api", "Productos"]
            }
          }
        },
        {
          "name": "2.2 Crear Producto con Admin (Permitido 201)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token_admin}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Pastillas de Freno Chevrolet Spark GT\",\n  \"codigoParte\": \"PF-SPK-001\",\n  \"precioVenta\": 45000.00,\n  \"stockInicial\": 30,\n  \"stockMinimo\": 5,\n  \"estado\": 0,\n  \"categoriaId\": \"6a832806-2a9c-48c7-83c2-1cdc385d3744\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Productos",
              "host": ["{{base_url}}"],
              "path": ["api", "Productos"]
            }
          }
        },
        {
          "name": "2.3 Crear Producto con Vendedor (Debe dar 403 Forbidden)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_vendedor}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Intento no autorizado de repuesto\",\n  \"codigoParte\": \"NO-AUTH\",\n  \"precioVenta\": 10000.00,\n  \"stockInicial\": 1,\n  \"stockMinimo\": 1,\n  \"estado\": 0,\n  \"categoriaId\": \"6a832806-2a9c-48c7-83c2-1cdc385d3744\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Productos",
              "host": ["{{base_url}}"],
              "path": ["api", "Productos"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Ventas (POS)",
      "item": [
        {
          "name": "3.1 Crear Venta con Token Vendedor (Permitido)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_vendedor}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroComprobante\": \"VTA-0011\",\n  \"metodoPago\": 1,\n  \"detalles\": [\n    {\n      \"productoId\": \"c08ecce2-1d06-405d-834a-b015469c4fea\",\n      \"cantidad\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Ventas",
              "host": ["{{base_url}}"],
              "path": ["api", "Ventas"]
            }
          }
        },
        {
          "name": "3.2 Crear Venta Sin Token (Debe dar 401 Unauthorized)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroComprobante\": \"VTA-0012\",\n  \"metodoPago\": 1,\n  \"detalles\": [\n    {\n      \"productoId\": \"c08ecce2-1d06-405d-834a-b015469c4fea\",\n      \"cantidad\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/Ventas",
              "host": ["{{base_url}}"],
              "path": ["api", "Ventas"]
            }
          }
        }
      ]
    }
  ]
}
